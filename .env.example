# Copy this file to `.env` and change only what you need.
# `.env` is ignored by git: never commit cookies, passwords or keys.

# Where the SQLite database is stored (created automatically)
# DB_PATH=data/ecomcheck.db

# Crawler politeness
# MAX_PAGES=5          # pages per search, 40 products per page
# REQUEST_DELAY=1.0    # seconds between two requests
# CACHE_MINUTES=30     # re-use a search made in the last N minutes

# Optional second source. Lazada answers automated requests with an anti-bot
# page, so it only runs with the cookie of your own browser session.
# LAZADA_COOKIE=

# Web app
# SECRET_KEY=change-me
# FLASK_DEBUG=0
